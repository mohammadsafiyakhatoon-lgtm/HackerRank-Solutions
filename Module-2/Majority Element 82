def majorityElement(arr):
    candidate=None
    count=0
    for num in arr:
        if count==0:
            candidate=num
        if num==candidate:
            count+=1
        else:
            count-=1
    if arr.count(candidate)>len(arr)//2:
        return candidate
    else:
        return -1
n=int(input())
arr=list(map(int, input().split()))
print(majorityElement(arr))
