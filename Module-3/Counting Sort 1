import math
import os
import random
import re
import sys
def countingSort(arr):
    frequency = []
    for i in range(100):
        frequency.append(0)
    for value in arr:
        frequency[value] = frequency[value] + 1
    return frequency
if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')
    n = int(input().strip())
    arr = list(map(int, input().rstrip().split()))
    result = countingSort(arr)
    fptr.write(' '.join(map(str, result)))
    fptr.write('\n')
    fptr.close()
